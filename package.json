{
  "name": "openhear",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "postinstall": "node scripts/setup-rnnoise.js && node scripts/patch-capacitor-tar.mjs",
    "test:capacitor": "node --test scripts/capacitor-tar.test.mjs",
    "test:braces-security": "node --test vendor/guarded-braces/test/security.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.0",
    "typescript": "6.0.3",
    "fast-glob": "file:vendor/next-eslint-glob",
    "braces": "file:vendor/guarded-braces",
    "@tailwindcss/postcss": "^4.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "postcss-selector-parser": "^7.1.6",
    "braces": "$braces"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
